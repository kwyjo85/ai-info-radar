THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://localhost:8000/callback
THREADS_ACCESS_TOKEN=
THREADS_TOKEN_EXPIRES_AT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=       # claude setup-token 으로 발급 (launchd 구동용)
LLM_BACKEND=claude_cli         # claude_cli | api

# 인스타 대시보드 잠금 비밀번호 (설정 시 매 사이클 자동 수집)
IG_DASHBOARD_PASSWORD=
# IG_DASHBOARD_URL=https://kwyjo85.github.io/ig-dashboard/data.enc.json

# GitHub Pages 대시보드 배포 — 기본은 이 저장소의 git origin으로 gh-pages 브랜치에 배포
# RADAR_SITE_REPO=git@github.com:kwyjo85/ai-info-radar.git   (origin과 다른 곳에 올릴 때만)
# RADAR_SITE_BRANCH=gh-pages
# RADAR_DASHBOARD_PASSWORD=   (비우면 IG_DASHBOARD_PASSWORD 재사용)

# DB 백업 — 사이클마다 data/radar.db를 하루 1개 파일로 복사 (복구: scripts/install_mac.sh)
# RADAR_BACKUP_DIR=   (비우면 iCloud Drive/ai-info-radar-backup)
# RADAR_BACKUP_KEEP=14
# RADAR_GIT_SYNC=0    (사이클 끝 자동 git 동기화 끄기)
