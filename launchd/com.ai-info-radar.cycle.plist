<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 템플릿: __ROOT__/__UV__/__PATH__는 scripts/install_mac.sh가 채워서 ~/Library/LaunchAgents에 등록 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-info-radar.cycle</string>
    <key>ProgramArguments</key>
    <array>
        <string>__UV__</string>
        <string>run</string>
        <string>python</string>
        <string>-m</string>
        <string>scripts.cycle</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>__ROOT__</string>
    <key>StandardOutPath</key>
    <string>__ROOT__/logs/launchd.cycle.log</string>
    <key>StandardErrorPath</key>
    <string>__ROOT__/logs/launchd.cycle.log</string>
</dict>
</plist>
